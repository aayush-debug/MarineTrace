# ── General Configuration ───────────────────────────
APP_NAME=MarineTrace
DEBUG=false
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./marinetrace.db

# ── Machine Learning (U-Net) ────────────────────────
USE_REAL_ML=true
ML_MODEL_PATH=ml/checkpoints/best_model.pth

# ── AIS Vessel Tracking ─────────────────────────────
# AIS provider: "aisstream", "datalastic", or leave empty for mock fallback
AIS_PROVIDER=aisstream
AIS_API_KEY=
AIS_BASE_URL=wss://stream.aisstream.io/v0/stream

# ── Copernicus Marine Metocean Currents ─────────────
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# ── Drift Simulation ────────────────────────────────
DRIFT_BACKWARD_HOURS=24
DRIFT_FORWARD_HOURS=24
DRIFT_TIMESTEP_MINUTES=15
DRIFT_NUM_PARTICLES=500

# ── Attribution Weights (must sum to 100) ───────────
WEIGHT_SPATIAL=30
WEIGHT_TEMPORAL=25
WEIGHT_TRAJECTORY=20
WEIGHT_BEHAVIOUR=15
WEIGHT_VESSEL_RELEVANCE=10
