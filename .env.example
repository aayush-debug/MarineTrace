# ==============================================================================
# MarineTrace Environment Configuration Template
# Placeholders only. NEVER commit real credentials to version control.
# ==============================================================================

# ── General Server Configuration ─────────────────────────────────────────────
APP_NAME=MarineTrace
DEBUG=false
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PORT=

# ── Security & CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (e.g. https://marinetrace.vercel.app)
CORS_ORIGINS=
JWT_SECRET_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite local or persistent mount path (e.g. sqlite:////app/db/marinetrace.db)
DATABASE_URL=sqlite:///./marinetrace.db

# ── Machine Learning (U-Net ResNet-34) ───────────────────────────────────────
USE_REAL_ML=true
ML_MODEL_VERSION=v2
ML_MODEL_PATH=ml/checkpoints/best_model_v2.pth
# Force specific compute device ("cpu", "cuda", or empty for auto-detection)
ML_DEVICE=

# ── AIS Vessel Tracking ──────────────────────────────────────────────────────
# Provider: "aisstream", "datalastic", or empty for mock fallback
AIS_PROVIDER=aisstream
AIS_API_KEY=
AIS_BASE_URL=wss://stream.aisstream.io/v0/stream

# ── Copernicus Marine Metocean Currents ──────────────────────────────────────
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
# Standard Copernicus Marine Service aliases:
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# ── Drift Simulation (OpenDrift) ─────────────────────────────────────────────
DRIFT_BACKWARD_HOURS=24
DRIFT_FORWARD_HOURS=24
DRIFT_TIMESTEP_MINUTES=15
DRIFT_NUM_PARTICLES=500

# ── Attribution Weights (must sum to 100) ────────────────────────────────────
WEIGHT_SPATIAL=30
WEIGHT_TEMPORAL=25
WEIGHT_TRAJECTORY=20
WEIGHT_BEHAVIOUR=15
WEIGHT_VESSEL_RELEVANCE=10

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Remote API base URL for production React frontend (e.g. https://marinetrace-backend.onrender.com)
VITE_API_URL=http://localhost:8000
